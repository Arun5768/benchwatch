{
  "name": "benchwatch-arun",
  "main": "src/worker.js",
  "compatibility_date": "2026-05-22",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "benchwatch-db",
      "database_id": "ea978058-a5b9-4e0e-888f-b9db5ba0a165",
      "migrations_dir": "migrations",
    },
  ],
}
